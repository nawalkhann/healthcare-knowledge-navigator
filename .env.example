# Public URL of the deployed site, used for canonical URLs, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://example.com

# Supabase (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider key for reranking and answers (added in step 3)
LLM_API_KEY=

# Google Search Console HTML-tag verification code (optional if verifying by DNS)
GOOGLE_SITE_VERIFICATION=
